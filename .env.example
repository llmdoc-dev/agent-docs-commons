# Local / test defaults. The production Worker uses wrangler.jsonc vars instead.

PORT=8787
PAYMENT_MODE=mock
# PAYMENT_MODE=x402 enables facilitator verify+settle. Mock headers are rejected in that mode.

# Throwaway devnet receiver (no secret is stored in this repo; not a user wallet).
PAY_TO=Gm3Ae1UTwJsLj5NKHhznJccYiGLMMdfJiZUJ39hLAsoH

# Solana devnet default for local runs.
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1

# Set to 1 only for a deliberate local mainnet experiment. The production Worker sets this path in wrangler.jsonc.
# ALLOW_MAINNET=1

# Devnet/test facilitator. Production uses https://facilitator.payai.network (no API key).
FACILITATOR_URL=https://x402.org/facilitator

PRICE_LOOKUP_USD=0.01
DB_PATH=data/commons.sqlite
PUBLIC_BASE_URL=http://127.0.0.1:8787
OWNER_PAYOUT_ADDRESS=7vUCMQL5U5RtyLskFrrW7L5i7YV4pTtqg72qG87BoxSB

# Public site-treasury address (receive-only). Never put the corresponding secret in this file, in wrangler secrets, or in the Worker.
