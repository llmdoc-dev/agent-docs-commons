{
  "name": "agent-docs-commons",
  "version": "0.1.0",
  "private": true,
  "description": "Docs commons for AI agents: pay $0.01 USDC per lookup via x402 on Solana, earn a 60% share for contributed facts.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "mcp": "tsx src/mcp.ts",
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "payout": "tsx scripts/payout.ts",
    "payout:dry-run": "tsx scripts/payout.ts --dry-run",
    "stats": "tsx scripts/stats.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "d1:migrate": "wrangler d1 migrations apply llmdocs --remote",
    "d1:seed": "tsx scripts/seed-d1.ts",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^24.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.166.0"
  }
}
